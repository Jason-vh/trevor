# SquashCity login
SQUASH_CITY_USERNAME=your_username
SQUASH_CITY_PASSWORD=your_password

# Telegram bot (use separate bot tokens for dev vs prod)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Where the SQLite databases live (optional, defaults to ./data)
# DATA_DIR=data

# Google Calendar integration (optional — omit to disable)
# CALENDAR_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Webhook mode (production only — omit for local dev to use polling)
# WEBHOOK_DOMAIN=trevor.vhtm.eu
# WEBHOOK_SECRET=random_secret_string
